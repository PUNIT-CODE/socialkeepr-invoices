rules_version = '2';
// SocialKeepr Invoices: each person can only read and write their own data under users/<their id>.
// Every write is checked: only known fields, sensible sizes, and nobody can change their own role.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function str(v, n) { return v is string && v.size() <= n; }
    function optStr(d, k, n) { return !(k in d) || str(d[k], n); }

    // Receipt photos for share links. Each photo is encrypted on the sender's device; the key is only inside the
    // password-locked link, so a stored copy is useless on its own. Anyone with the exact id can fetch the
    // encrypted copy until the link expires; nobody can list them; only the sender can create or delete them.
    match /shares/{sid} {
      allow get: if sid.matches('s[A-Za-z0-9_-]{10,30}') && resource.data.exp > request.time;
      allow list, update: if false;
      allow create: if request.auth != null && sid.matches('s[A-Za-z0-9_-]{10,30}')
        && request.resource.data.keys().hasOnly(['owner', 'exp', 'n', 'at'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.exp is timestamp && request.resource.data.exp < request.time + duration.value(400, 'd')
        && request.resource.data.n is int && request.resource.data.n <= 50;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      match /files/{fid} {
        allow get: if resource.data.exp > request.time;
        allow list, update: if false;
        allow create: if request.auth != null && fid.matches('f[0-9]{1,2}')
          && get(/databases/$(database)/documents/shares/$(sid)).data.owner == request.auth.uid
          && request.resource.data.keys().hasOnly(['owner', 'exp', 'iv', 'c'])
          && request.resource.data.owner == request.auth.uid
          && request.resource.data.exp == get(/databases/$(database)/documents/shares/$(sid)).data.exp
          && str(request.resource.data.iv, 40) && str(request.resource.data.c, 1000000);
        allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      }
    }

    match /users/{uid} {
      function validMember(d) {
        return d.keys().hasOnly(['email', 'name', 'photo', 'phone', 'role', 'createdAt', 'updatedAt'])
          && optStr(d, 'email', 200) && optStr(d, 'name', 60) && optStr(d, 'photo', 300000) && optStr(d, 'phone', 20)
          && optStr(d, 'createdAt', 40) && optStr(d, 'updatedAt', 40);
      }
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.role == 'staff' && validMember(request.resource.data);
      allow update: if isOwner(uid) && request.resource.data.role == resource.data.role && validMember(request.resource.data);
      allow delete: if false;

      match /invoices/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && id.matches('inv-[0-9]{1,6}')
          && request.resource.data.no is int && request.resource.data.no >= 1 && request.resource.data.no <= 999999
          && request.resource.data.rows is list && request.resource.data.rows.size() <= 50
          && request.resource.data.keys().hasOnly(['no', 'date', 'billedTo', 'services', 'hours', 'hoursDays', 'gst', 'paid', 'paidAt', 'rows', 'totalOverride', 'note', 'importedFrom', 'createdAt', 'updatedAt', 'weekStart'])
          && optStr(request.resource.data, 'billedTo', 120) && optStr(request.resource.data, 'services', 120) && optStr(request.resource.data, 'note', 300);
      }
      match /receipts/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && id.matches('r[a-z0-9]{4,24}')
          && request.resource.data.keys().hasOnly(['id', 'img', 'w', 'h', 'amount', 'date', 'merchant', 'cat', 'createdAt'])
          && str(request.resource.data.img, 1500000) && optStr(request.resource.data, 'merchant', 80);
      }
      match /messages/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && id.matches('m[a-z0-9]{4,16}')
          && request.resource.data.keys().hasOnly(['job', 'date', 'client', 'tpl', 'text', 'to', 'at'])
          && str(request.resource.data.text, 1000) && optStr(request.resource.data, 'to', 20) && optStr(request.resource.data, 'job', 200);
        allow update: if false;
      }
      match /push/{id} {
        // this person's phones and computers that asked for notifications
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && id.matches('d[0-9a-f]{24}')
          && request.resource.data.keys().hasOnly(['endpoint', 'keys', 'ua', 'at'])
          && str(request.resource.data.endpoint, 1000) && request.resource.data.endpoint.matches('https://.*')
          && request.resource.data.keys is map && request.resource.data.keys.keys().hasOnly(['p256dh', 'auth'])
          && str(request.resource.data.keys.p256dh, 200) && str(request.resource.data.keys.auth, 100) && optStr(request.resource.data, 'ua', 200);
      }
      match /notifications/{id} {
        // written only by the reminder service; the person can read them, mark them read, or delete them
        allow read, delete: if isOwner(uid);
        allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool;
        allow create: if false;
      }
      match /server/{docId} {
        // reminder service bookkeeping; only the server (admin) can touch it
        allow read, write: if false;
      }
      match /private/{docId} {
        // 'icloud' holds the Apple app-specific password for the calendar: it can be written or deleted, never read back
        // (only the reminder service reads it). 'calendar' is written only by the reminder service.
        allow read: if isOwner(uid) && docId != 'icloud';
        allow create, update: if isOwner(uid) && (docId in ['profile', 'settings']
          || (docId.matches('plan-[0-9]{4}-[0-9]{2}-[0-9]{2}') && request.resource.data.keys().hasOnly(['date', 'json', 'at']) && str(request.resource.data.json, 900000))
          || (docId == 'icloud' && request.resource.data.keys().hasOnly(['appleId', 'appPassword', 'at']) && str(request.resource.data.appleId, 200) && request.resource.data.appPassword.matches('[a-z]{4}-[a-z]{4}-[a-z]{4}-[a-z]{4}')));
        allow delete: if isOwner(uid) && docId != 'calendar';
      }
    }
  }
}
