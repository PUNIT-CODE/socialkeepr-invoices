rules_version = '2';
// SocialKeepr Invoices: each person can only read and write their own data under users/<their id>.
// Nobody can make themselves a manager: the role field can only be "staff" when they create their record,
// and only you (from the Firebase console) can change it later.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.role == 'staff';
      allow update: if isOwner(uid) && request.resource.data.role == resource.data.role;
      allow delete: if false;

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
